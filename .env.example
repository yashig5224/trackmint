# Supabase Connection
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# App Environment
VITE_APP_URL=https://trackmint-ashen.vercel.app
VITE_PAYMENTS_CLIENT_TOKEN=

# Push Notifications (Firebase Cloud Messaging - Optional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# Error Monitoring (Sentry - Optional)
VITE_SENTRY_DSN=

# ── Supabase Edge Function Secrets (Set via: npx supabase secrets set KEY=VALUE) ──
# Hugging Face Embeddings (Sentence Transformers all-MiniLM-L6-v2)
HUGGINGFACE_API_KEY=hf_your_huggingface_token

# AI Providers & Open-Weight LLMs
GROQ_API_KEY=gsk_your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=sk-your_openai_api_key
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key

# Local / Self-Hosted Open-Weight LLM (Optional: Ollama / vLLM / LocalAI)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2
LOCAL_LLM_API_KEY=ollama

